{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cobotar/protocol/subjects/catalog.schema.json",
  "title": "CobotAR NATS subject catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "conformance", "components", "routes"],
  "properties": {
    "version": { "const": 1 },
    "conformance": { "$ref": "#/$defs/conformance" },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["staged", "enforced"] },
        "tracking_issue": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "staged" } } },
          "then": { "required": ["tracking_issue"] },
          "else": { "not": { "required": ["tracking_issue"] } }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "subject_token" }
      }
    },
    "replies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "success": { "type": "string" },
        "failure": { "type": "string" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pattern", "lifecycle", "conformance"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "pattern": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["planned", "active", "deprecated", "retired"] },
        "conformance": { "$ref": "#/$defs/conformance" },
        "interaction": { "enum": ["publish", "request_reply"] },
        "payload": { "type": "string" },
        "request": { "type": "string" },
        "empty_request": { "type": "boolean" },
        "replies": { "$ref": "#/$defs/replies" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameter" }
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "parameters"],
            "properties": {
              "name": { "$ref": "#/$defs/token" },
              "parameters": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/token" }
              }
            }
          }
        },
        "publishers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        },
        "replacement": { "type": "string" },
        "description": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "lifecycle": { "const": "retired" } } },
          "else": { "required": ["interaction", "publishers", "consumers"] }
        },
        {
          "if": { "properties": { "lifecycle": { "const": "planned" } } },
          "then": {
            "properties": {
              "conformance": {
                "properties": { "mode": { "const": "staged" } }
              }
            }
          }
        }
      ]
    }
  }
}
